# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://localhost:27017/tripwise

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d
GOOGLE_CLIENT_ID=your_google_client_id_here

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Email SMTP Gateway
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@tripwise.com

# Flight Search API (Duffel - duffel.com)
DUFFEL_ACCESS_TOKEN=your_duffel_access_token_here

# Hotel & Rail Live Search APIs (RapidAPI - rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_RAIL_HOST=irctc-indian-railway-livetrains-api.p.rapidapi.com

# Geoapify Places API (geoapify.com)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

