{
  "name": "tripwise-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "server": "npm run dev -w server",
    "client": "npm run dev -w client",
    "dev": "npx concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server"
  }
}

